<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Runesmith's Java project templates: application, library, compact source file and multi-module project, for Maven, Gradle or no build system.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.Java.Templates.Contracts\Runesmith.Java.Templates.Contracts.csproj" />
    <!-- Runesmith supplies the SDK when it loads the plugin, so it is not copied next to it. -->
    <PackageReference Include="Runesmith.Sdk" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.Java.Templates.Tests" />
  </ItemGroup>
</Project>
